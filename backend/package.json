{
  "name": "webpulse-backend",
  "version": "1.0.0",
  "description": "WebPulse API - Intelligent Web Scraper & AI Data Explorer",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/workers/scrapeWorker.js",
    "worker:dev": "node --watch src/workers/scrapeWorker.js",
    "migrate": "node src/db/migrate.js",
    "drizzle:up": "drizzle-kit up --config ./drizzle.config.ts",
    "migrate:down": "node src/db/migrate.js down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.0",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "puppeteer": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
